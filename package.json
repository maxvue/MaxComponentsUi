{
    "name": "max-components-ui",
    "version": "0.0.10",
    "description": "Biblioteca de componentes Vue baseada em PrimeVue",
    "main": "./dist/index.js",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.js"
        },
        "./dist/style.css": "./dist/style.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "dev:playground": "vite --config playground/vite.config.ts",
        "build": "vue-tsc && vite build",
        "build:uno": "node scripts/build-uno.mjs",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.0",
        "@unocss/reset": "^66.6.8",
        "@vueuse/core": "^14.2.1",
        "primeicons": "^7.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/eslint-config-typescript": "^14.1.3",
        "@vue/tsconfig": "^0.7.0",
        "ajv": "^8.18.0",
        "eslint": "^9.17.0",
        "eslint-plugin-vue": "^9.32.0",
        "sass-embedded": "^1.99.0",
        "typescript": "~5.7.2",
        "unocss": "^66.6.8",
        "vite": "^6.0.0",
        "vite-plugin-dts": "^4.5.4",
        "vue-tsc": "^2.1.10",
        "vue": "^3.5.13",
        "primevue": "^4.5.5",
        "@primeuix/themes": "^2.0.3"
    },
    "keywords": [
        "vue",
        "vue3",
        "components",
        "ui",
        "primevue",
        "typescript"
    ],
    "author": "Johnattas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/johnattas/MaxComponentsUi.git"
    },
    "peerDependencies": {
        "vue": "^3.5.13",
        "primevue": "^4.5.0",
        "@primeuix/themes": "^2.0.0"
    }
}
