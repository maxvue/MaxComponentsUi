{
    "name": "@maxvue/max-components-ui",
    "version": "1.0.53",
    "description": "Biblioteca de componentes Vue baseada em PrimeVue",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js"
        },
        "./preset": {
            "types": "./dist/presetMaxUno.d.ts",
            "import": "./dist/preset.es.js"
        },
        "./resolver": {
            "types": "./dist/helpers/resolver.d.ts",
            "import": "./dist/resolver.es.js"
        },
        "./prime": {
            "types": "./dist/prime/index.d.ts",
            "import": "./dist/prime.es.js"
        },
        "./stores": {
            "types": "./dist/stores/index.d.ts",
            "import": "./dist/stores/index.es.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "dev:playground": "vite --config playground/vite.config.ts",
        "build": "vue-tsc && vite build && cp -r src/themes dist/",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint . --fix && stylelint \"**/*.{scss,vue}\" --fix",
        "release": "npm run build && npm version patch -m 'Upgrade to %s' && git push origin main --follow-tags && npm publish --access public",
        "typecheck:tsgo": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.1",
        "@lottiefiles/dotlottie-vue": "^0.11.15",
        "@maxvue/max-use": "file:../MaxUse",
        "@primeuix/themes": "^2.0.3",
        "@tanstack/vue-virtual": "^3.13.26",
        "@unocss/reset": "^66.7.0",
        "axios": "^1.16.1",
        "color": "^5.0.3",
        "libphonenumber-js": "^1.13.3",
        "maska": "^3.2.0",
        "pinia": "^3.0.4",
        "primevue": "^4.5.5",
        "quill": "^2.0.3",
        "vite-plugin-css-injected-by-js": "^5.0.1",
        "vue-pdf-embed": "^2.1.4",
        "vue3-google-map": "^0.27.1"
    },
    "devDependencies": {
        "@pinia/testing": "^1.0.3",
        "@primeuix/themes": "^2.0.3",
        "@primevue/auto-import-resolver": "^4.5.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/stylelint-plugin": "^5.2.0",
        "@types/node": "^25.9.1",
        "@typescript/native-preview": "^7.0.0-dev.20260527.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/coverage-v8": "^4.1.7",
        "@vue/eslint-config-typescript": "^14.7.0",
        "@vue/test-utils": "^2.4.10",
        "@vue/tsconfig": "^0.9.1",
        "ajv": "^8.20.0",
        "eslint": "^10.4.0",
        "eslint-plugin-vue": "^10.9.1",
        "happy-dom": "^20.9.0",
        "postcss-html": "^1.8.1",
        "primevue": "^4.5.5",
        "sass-embedded": "^1.100.0",
        "stylelint": "^17.12.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "terser": "^5.48.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0",
        "unocss": "^66.7.0",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.0.14",
        "vite-plugin-dts": "^5.0.1",
        "vitest": "^4.1.7",
        "vue": "^3.6.0-beta.14",
        "vue-eslint-parser": "^10.4.0",
        "vue-router": "^5.1.0",
        "vue-tsc": "^3.3.2"
    },
    "keywords": [
        "vue",
        "vue3",
        "components",
        "ui",
        "primevue",
        "typescript"
    ],
    "author": "Johnattas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/maxvue/MaxComponentsUi.git"
    },
    "peerDependencies": {
        "vue": "^3.5.33",
        "vue-router": "^5.0.6"
    }
}