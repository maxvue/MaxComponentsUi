{
    "name": "@maxvue/max-components-ui",
    "version": "1.1.2",
    "description": "Biblioteca de componentes Vue baseada em PrimeVue",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js"
        },
        "./preset": {
            "types": "./dist/presetMaxUno.d.ts",
            "import": "./dist/preset.es.js"
        },
        "./resolver": {
            "types": "./dist/helpers/resolver.d.ts",
            "import": "./dist/resolver.es.js"
        },
        "./prime": {
            "types": "./dist/prime/index.d.ts",
            "import": "./dist/prime.es.js"
        },
        "./stores": {
            "types": "./dist/stores/index.d.ts",
            "import": "./dist/stores/index.es.js"
        },
        "./dist/components/*.vue": {
            "types": "./dist/components/*.vue.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "dev:playground": "vite --config playground/vite.config.ts",
        "build": "vue-tsc && vite build && cp -r src/themes dist/",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint . --fix && stylelint \"**/*.{scss,vue}\" --fix",
        "release": "npm run build && npm version patch -m 'Upgrade to %s' && git push origin main --follow-tags && npm publish --access public",
        "typecheck:tsgo": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.1",
        "@lottiefiles/dotlottie-vue": "^0.11.24",
        "@maxvue/max-pinia": "file:../MaxPinia",
        "@maxvue/max-use": "file:../MaxUse",
        "@primeuix/themes": "^2.0.3",
        "@tanstack/vue-virtual": "^3.13.35",
        "@tiptap/extension-image": "^3.29.2",
        "@tiptap/extension-link": "^3.29.2",
        "@tiptap/extension-table": "^3.29.2",
        "@tiptap/extension-table-cell": "^3.29.2",
        "@tiptap/extension-table-header": "^3.29.2",
        "@tiptap/extension-table-row": "^3.29.2",
        "@tiptap/extension-underline": "^3.29.2",
        "@tiptap/starter-kit": "^3.29.2",
        "@tiptap/vue-3": "^3.29.2",
        "@unocss/reset": "^66.7.5",
        "axios": "^1.19.0",
        "chart.js": "^4.5.1",
        "color": "^5.0.3",
        "libphonenumber-js": "^1.13.10",
        "maska": "^3.2.0",
        "pinia": "^4.0.2",
        "primevue": "^4.5.5",
        "quill": "^2.0.3",
        "sass": "^1.102.0",
        "splitpanes": "^4.1.2",
        "tiptap-markdown": "^0.9.0",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vue-pdf-embed": "^2.1.5",
        "vue3-google-map": "^0.27.2"
    },
    "devDependencies": {
        "@pinia/testing": "^2.0.1",
        "@primeuix/themes": "^2.0.3",
        "@primevue/auto-import-resolver": "^4.5.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/stylelint-plugin": "^5.2.1",
        "@types/node": "^26.1.2",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/devtools-api": "^8.2.1",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "@vueuse/core": "^14.4.0",
        "ajv": "^8.20.0",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "happy-dom": "^20.11.1",
        "postcss-html": "^2.0.0",
        "primevue": "^4.5.5",
        "sass-embedded": "^1.100.0",
        "stylelint": "^17.14.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "terser": "^5.49.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0",
        "unocss": "^66.7.5",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.2.1",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.10",
        "vue": "^3.6.0-rc.2",
        "vue-eslint-parser": "^10.4.1",
        "vue-router": "^5.2.0",
        "vue-tsc": "^3.3.9"
    },
    "keywords": [
        "vue",
        "vue3",
        "components",
        "ui",
        "primevue",
        "typescript"
    ],
    "author": "Johnattas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/maxvue/MaxComponentsUi.git"
    },
    "peerDependencies": {
        "vue": "^3.6.0-rc.2",
        "vue-router": "^5.0.6"
    }
}
