{
    "name": "@maxvue/max-components-ui",
    "version": "1.0.20",
    "description": "Biblioteca de componentes Vue baseada em PrimeVue",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js"
        },
        "./preset": {
            "types": "./dist/unoCssPreset.d.ts",
            "import": "./dist/preset.es.js"
        },
        "./resolver": {
            "types": "./dist/helpers/resolver.d.ts",
            "import": "./dist/resolver.es.js"
        },
        "./dist/style.css": "./dist/style.css"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "dev:playground": "vite --config playground/vite.config.ts",
        "prebuild": "npx tsx src/scripts/generateResolver.ts",
        "build": "vue-tsc && vite build && cp -r src/themes dist/",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint . --fix && stylelint \"**/*.{scss,vue}\" --fix",
        "postbuild": "git add dist tsconfig.tsbuildinfo && git commit -m 'chore: atualiza artefatos do build' || true",
        "release": "npm run build && npm version patch -m 'Upgrade to %s' && git push origin main --follow-tags && npm publish --access public"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.0",
        "@lottiefiles/dotlottie-vue": "^0.11.12",
        "@maxvue/max-use": "^1.0.8",
        "@primeuix/themes": "^2.0.3",
        "@unocss/reset": "^66.6.8",
        "@vueuse/core": "^14.2.1",
        "libphonenumber-js": "^1.12.42",
        "maska": "^3.2.0",
        "motion-v": "^2.2.1",
        "primevue": "^4.5.5",
        "vite-plugin-css-injected-by-js": "^5.0.1",
        "vue-pdf-embed": "^2.1.4",
        "vue-router": "^5.0.6",
        "vue3-google-map": "^0.27.1"
    },
    "devDependencies": {
        "@primeuix/themes": "^2.0.3",
        "@primevue/auto-import-resolver": "^4.5.5",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/stylelint-plugin": "^5.1.0",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/eslint-config-typescript": "^14.7.0",
        "@vue/tsconfig": "^0.9.1",
        "ajv": "^8.20.0",
        "eslint": "^10.2.1",
        "eslint-plugin-vue": "^10.9.0",
        "postcss-html": "^1.8.1",
        "primevue": "^4.5.5",
        "sass-embedded": "^1.99.0",
        "stylelint": "^17.10.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "terser": "^5.46.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.59.1",
        "unocss": "^66.6.8",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^32.0.0",
        "vite": "^8.0.10",
        "vite-plugin-dts": "^4.5.4",
        "vue": "^3.5.33",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.2.7"
    },
    "keywords": [
        "vue",
        "vue3",
        "components",
        "ui",
        "primevue",
        "typescript"
    ],
    "author": "Johnattas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/maxvue/MaxComponentsUi.git"
    },
    "peerDependencies": {
        "vue": "^3.5.33"
    }
}
