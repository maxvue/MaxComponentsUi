    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "dev:playground": "vite --config playground/vite.config.ts",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "type-check:test": "vue-tsc -p tsconfig.test.json --noEmit",
    "check:filenames": "node scripts/check-tracked-filenames.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "lint": "npm run lint:check",
    "lint:check": "eslint . && stylelint \"src/**/*.{scss,vue}\"",
    "optimize:svg": "node scripts/optimize-svgs.mjs",
    "optimize:svg:check": "node scripts/optimize-svgs.mjs --check",
    "check:playground:bundle": "node scripts/check-playground-bundle.mjs",
    "check:npm-tree": "npm ls --all",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run check:filenames && npm run check:lockfile && npm run optimize:svg:check && npm run type-check && npm run type-check:test && npm run lint:check && npm run build && npm run test && npm run test:coverage && npm run test:browser && npm run check:playground:bundle && npm run test:benchmark && npm run verify:consumers && npm run check:npm-tree && npm run check:audit",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "verify:package": "node scripts/verify-package-consumer.mjs",
    "prerelease": "node -e \"const b=require('node:child_process').execSync('git branch --show-current').toString().trim(); if(b!=='main'){console.error(`Release só é permitido a partir da branch main (branch atual: ${b}).`); process.exit(1);}\"",
    "release": "npm run verify && npm version patch -m 'Upgrade to %s' && git push origin main --follow-tags && npm publish --access public",
    "typecheck:tsgo": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:benchmark": "vitest run --config vitest.benchmark.config.ts"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/style.css"
  ],
