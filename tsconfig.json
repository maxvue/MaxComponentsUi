{
    "include": [
        "env.d.ts",
        "./src/**/*",
        "./src/**/*.vue",
        "./src/**/*.json",
        "scripts"
    ],
    "exclude": [
        "src/**/__tests__/*",
        "node_modules",
        "dist",
        // Arquivos órfãos trazidos da app Engeapp: não são exportados por
        // src/index.ts nem por src/stores/index.ts, não estão no manifesto do
        // resolver e não são referenciados por nenhum componente ou teste.
        // Dependem de globals auto-importados da app (user, loading, version,
        // useWindowSize, useRefCached, PageLayout, VoipDialer...) que não
        // existem nesta biblioteca. Mantidos como referência, fora do build.
        "src/stores/useApp.Store.ts",
        "src/stores/useLogin.Store.ts",
        "src/components/MaxApp.vue"
    ],
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": false,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "module": "ESNext",
        "target": "ESNext",
        "useDefineForClassFields": true,
        "types": [
            "node"
        ],
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        // "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    }
}